# ===============================
#  AI Moral Code Project
#  Clean .gitignore for Decap CMS + Netlify
# ===============================

# --- System / Editor ---
.DS_Store
.vscode/
*.code-workspace

# --- Node / Build ---
node_modules/
dist/
build/
.cache/
npm-debug.log*
yarn-error.log*

# --- Ruby / Jekyll legacy ---
_site/
.bundle/
vendor/
vendor/bundle/
.ruby-version
Gemfile
Gemfile.lock
_config.yml
_includes/
_layouts/
_posts/

# --- Environment & API Keys ---
.env
.env.*

# --- Local Scripts / Dev Utilities ---
scripts/
features/
*.sh

# --- Local Reference / Non-Deploy Docs ---
docs/
legacy/
*.zip
*.pptx
*.bak
*.tmp

# --- Task Management Files ---
# Keep AIMC core task list tracked, ignore website version
AIMC_Website_TASK_LIST.md

# --- CMS uploads (handled via Git) ---
# Keep image assets tracked
!assets/img/

# --- Exclusions ---
# Do NOT ignore important site content:
!content/**
!admin/**
!index.html
!CNAME
!citation.cff
!AIMC_TASK_LIST.md
